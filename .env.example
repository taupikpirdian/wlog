# Load these variables into your shell before running wl:
# source .env.example
# wl does not load .env files automatically.
# Supported skills: root-cause-summary, ticket-generator.
# The selected skill must already be installed.

# Skill for the details ticket section of wl summary.
export WLOG_SUMMARY_SKILL=root-cause-summary

# Skill for wl gt / wl generate-ticket.
export WLOG_TICKET_SKILL=ticket-generator
